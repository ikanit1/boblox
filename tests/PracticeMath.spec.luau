local PracticeMath = require("../src/shared/PracticeMath")
local count = 0
local function check(value: boolean)
	assert(value, "Practice policy case " .. (count + 1))
	count += 1
end
check(PracticeMath.canCheckpoint(0, 1, 0, 0, 0, 0, 1))
check(PracticeMath.canCheckpoint(6, 7, 4.3, -4.3, 0.6, 2.9, 1))
check(not PracticeMath.canCheckpoint(0, 7, 0, 0, 0, 0, 8))
check(not PracticeMath.canCheckpoint(7, 8, 0, 0, 0, 0, 1))
check(not PracticeMath.canCheckpoint(0, 1, 7, 0, 0, 0, 1))
check(not PracticeMath.canCheckpoint(0, 1, 0, 0, 3, 0, 1))
check(not PracticeMath.canCheckpoint(0, 1, 0, 0, 0, 10, 1))
check(not PracticeMath.canCheckpoint(0, 1, 0, 0, 0, 0, 0.3))
check(not PracticeMath.canCheckpoint(1, 1, 0, 0, 0, 0, 1))
check(PracticeMath.canInteract("Practice", false, 10, 1))
check(PracticeMath.canInteract("Join", false, 0, 0.5))
check(not PracticeMath.canInteract("Practice", true, 0, 1))
check(not PracticeMath.canInteract("Practice", false, 14, 1))
check(not PracticeMath.canInteract("Join", false, 0, 0.1))
check(not PracticeMath.canInteract({}, false, 0, 1))
check(not PracticeMath.canInteract("AwardCoins", false, 0, 1))
check(not PracticeMath.canCheckpoint(0, 1, 0 / 0, 0, 0, 0, 1))
print("Practice policy checks passed: " .. count)
